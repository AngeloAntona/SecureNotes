<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Main dark mode theme -->
    <style name="Theme.SuperSecureNotes" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:colorBackground">@color/black</item>
        <item name="android:textColorPrimary">@color/primaryTextColorNight</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="colorAccent">@color/white</item>

        <!-- Contextual Action Mode customization for dark mode -->
        <item name="actionModeBackground">@color/black</item>
        <item name="android:actionModeBackground">@color/black</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:actionModeCloseDrawable">@android:drawable/ic_menu_close_clear_cancel</item>

        <!-- Custom AlertDialog style -->
        <item name="alertDialogTheme">@style/CustomAlertDialogTheme.Dark</item>
    </style>

    <!-- Custom AlertDialog style for dark mode -->
    <style name="CustomAlertDialogTheme.Dark" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:colorBackground">@color/black</item>
        <item name="android:textColorPrimary">@color/white</item>
    </style>

    <!-- Dark mode SplashScreen theme -->
    <style name="Theme.App.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo_b</item>
        <item name="postSplashScreenTheme">@style/Theme.SuperSecureNotes</item>
    </style>
</resources>
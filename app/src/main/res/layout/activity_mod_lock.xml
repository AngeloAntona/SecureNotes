<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:colorBackground"
    android:padding="24dp">

    <!-- Screen title -->
    <TextView
        android:id="@+id/screenTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SECURITY SETTINGS"
        android:textStyle="bold"
        android:textSize="25sp"
        android:textColor="?android:textColorPrimary"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:layout_marginBottom="40dp" />

    <!-- Instruction to enter current password -->
    <TextView
        android:id="@+id/currentPasswordInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:text="Enter your current password to modify settings."
        android:textColor="?android:textColorPrimary"
        android:textSize="16sp" />

    <!-- Password input field -->
    <EditText
        android:id="@+id/previousPasswordEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="• • •"
        android:inputType="textPassword"
        android:padding="10dp"
        android:textSize="14sp"
        android:gravity="center"
        android:textColor="?android:textColorPrimary"
        android:textColorHint="?android:textColorPrimary"
        android:layout_marginBottom="14dp" />

    <!-- Two-column section for password change and biometric management -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="329dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Password change section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Header and instructions -->
            <TextView
                android:id="@+id/changePasswordHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:text="Change password"
                android:textColor="?android:textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- New password input field -->
            <EditText
                android:id="@+id/newPasswordEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:hint="• • •"
                android:inputType="textPassword"
                android:padding="10dp"
                android:textColor="?android:textColorPrimary"
                android:textColorHint="?android:textColorPrimary"
                android:textSize="14sp" />

            <!-- Confirm password input field -->
            <EditText
                android:id="@+id/repeatNewPasswordEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:hint="• • •"
                android:inputType="textPassword"
                android:padding="10dp"
                android:textColor="?android:textColorPrimary"
                android:textColorHint="?android:textColorPrimary"
                android:textSize="14sp" />

            <!-- Button to confirm password change -->
            <Button
                android:id="@+id/savePasswordButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/rounded_button"
                android:padding="16dp"
                android:text="Change Password"
                android:textColor="?android:colorBackground"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/passwordStrengthTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:paddingTop="12dp"
                android:text="Password must be at least 8 characters."
                android:textColor="?android:textColorPrimary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Vertical divider with reduced margin -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            android:background="?android:dividerHorizontal" />

        <!-- Biometric authentication section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Header and instructions -->
            <TextView
                android:id="@+id/biometricHeader"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="4dp"
                android:gravity="top"
                android:text="Toggle biometrics"
                android:textColor="?android:textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Button to enable/disable biometrics -->
            <Button
                android:id="@+id/enableBiometricButton"
                android:layout_width="157dp"
                android:layout_height="157dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/round_button"
                android:text="Enable Biometrics"
                android:textColor="?android:colorBackground"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/biometricStatusTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:paddingTop="10dp"
                android:text="Status: Unknown"
                android:textColor="?android:textColorPrimary"
                android:textSize="14sp" />

        </LinearLayout>
    </LinearLayout>

    <!-- Horizontal divider to separate sections -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="?android:dividerHorizontal" />

    <!-- Contacts information section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/contactsHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:gravity="center"
            android:text="Contacts"
            android:textColor="?android:textColorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Short prompt text after the title -->
        <TextView
            android:id="@+id/contactPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bugs or questions? Drop me a line."
            android:textSize="14sp"
            android:textColor="?android:textColorPrimary"
            android:gravity="center"
            android:layout_marginBottom="1dp" />

        <TextView
            android:id="@+id/emailInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email: angeloantona.contact@gmail.com"
            android:autoLink="email"
            android:linksClickable="true"
            android:textColor="?android:textColorPrimary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/linkedinInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LinkedIn: https://www.linkedin.com/in/angeloantona/"
            android:autoLink="web"
            android:linksClickable="true"
            android:textColor="?android:textColorPrimary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="8dp" />
    </LinearLayout>
</LinearLayout>